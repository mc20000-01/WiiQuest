<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WBB Quest Bridge"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bridge: waiting..."
            android:textColor="#FFCC66"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Listening on UDP port:"
            android:textColor="#AAAAAA" />

        <TextView
            android:id="@+id/listenPortValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <!-- Live sensor readout -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Live sensor values"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rawValues"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="TL --  TR --\nBL --  BR --\nTotal -- kg"
            android:textColor="#66FF99"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/balanceValues"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="Lean X --   Lean Y --"
            android:textColor="#66CCFF"
            android:textSize="16sp" />

        <!-- Mapping -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Stick mapping"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Left stick X source"
            android:textColor="#AAAAAA" />
        <Spinner
            android:id="@+id/stickXSpinner"
            android:layout_width="260dp"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Left stick Y source"
            android:textColor="#AAAAAA" />
        <Spinner
            android:id="@+id/stickYSpinner"
            android:layout_width="260dp"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Button mapping"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Button A source"
            android:textColor="#AAAAAA" />
        <Spinner
            android:id="@+id/buttonASpinner"
            android:layout_width="260dp"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Button B source"
            android:textColor="#AAAAAA" />
        <Spinner
            android:id="@+id/buttonBSpinner"
            android:layout_width="260dp"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Button X source"
            android:textColor="#AAAAAA" />
        <Spinner
            android:id="@+id/buttonXSpinner"
            android:layout_width="260dp"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Button Y source"
            android:textColor="#AAAAAA" />
        <Spinner
            android:id="@+id/buttonYSpinner"
            android:layout_width="260dp"
            android:layout_height="wrap_content" />

        <!-- Output -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Publish mapped controller state to 127.0.0.1 : port"
            android:textColor="#AAAAAA" />
        <EditText
            android:id="@+id/outputPortInput"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save mapping" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#66FF99" />

    </LinearLayout>
</ScrollView>
